LIB "primdec.lib";
ring r=0,(u,x0,x1,x2,x3,x4,x5,x6,x7,x8,x9),lp;
ideal K=x1*x6 + 1/2,x1*x8 - x1 + 1,x1*x9 - x1 - 1,x2*x7 + 1/2,x0*x2 - x2*x8 - 1,x0*x2 + x2*x9 + 1,x3*x6 - x4*x6 + 1,x0*x3*x7 + x0 - x4*x7,x3*x9 + x4 + 1,x4*x6 - x5*x6 + 1,x0*x5*x7 + x0 + x4*x7,x4 - x5*x8 + 1,u*x0*x1*x2*x3*x4*x5*x6*x7*x8*x9-1;
ideal G=std(K);
ideal J=eliminate(G,u);
ring s=0,(x0,x1,x2,x3,x4,x5,x6,x7,x8,x9),lp;
ideal J=imap(r,J);
print("CASE E2");
print("SATURATED_DIM"); print(dim(std(J)));
print("SATURATED_VDIM"); print(vdim(std(J)));
print("SATURATED_GB"); print(std(J));
list P=primdecGTZ(J);
print("PRIMARY_COMPONENT_COUNT"); print(size(P));
for (int i=1; i<=size(P); i++) { print("COMPONENT"); print(i); print(dim(std(P[i][1]))); print(P[i][1]); }
